# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- NextAuth ---
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# --- Google OAuth (NextAuth) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Allowlist (comma-separated emails) ---
ALLOWED_EMAILS=your@email.com,team@email.com

# --- Webhook secrets ---
# HMAC secret for inbound /api/webhook/ticket-in (verify upstream sender)
INBOUND_WEBHOOK_HMAC_SECRET=generate-with-openssl-rand-hex-32
# Shared secret n8n uses to call back to /api/webhook/n8n-callback
N8N_CALLBACK_SECRET=generate-with-openssl-rand-hex-32

# --- LLMs ---
# Anthropic (classification, drafting, self-grading)
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI (embeddings only — text-embedding-3-small)
OPENAI_API_KEY=sk-...

# --- n8n integration ---
# Tunnel URL where the main n8n workflow listens
N8N_WEBHOOK_URL=https://n8n.your-tunnel.example.com/webhook/respond-ticket

# --- Used by scripts/ingest_kb.js + n8n (server-side only) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

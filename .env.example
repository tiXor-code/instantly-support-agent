# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Mirrors of the above for n8n + scripts (server-only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- NextAuth ---
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# --- Google OAuth (NextAuth) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Allowlist (comma-separated emails) ---
ALLOWED_EMAILS=your@email.com,team@email.com

# --- Webhook secrets ---
INBOUND_WEBHOOK_HMAC_SECRET=generate-with-openssl-rand-hex-32
N8N_CALLBACK_SECRET=generate-with-openssl-rand-hex-32

# --- Azure OpenAI (used by both ingest_kb.js and the n8n workflow) ---
# Created via `az cognitiveservices account create` (kind=OpenAI, sku=S0).
# Two GlobalStandard deployments live in Sweden Central:
#   - gpt-4o-mini             → classify + self-grade
#   - text-embedding-3-small  → KB indexing + per-ticket query embeddings
AZURE_ISA_ENDPOINT=https://your-azure-resource.openai.azure.com/
AZURE_ISA_KEY=your-azure-key
AZURE_ISA_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_ISA_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_ISA_API_VERSION=2024-10-21

# --- Claude CLI (used only by the Draft step in the n8n workflow) ---
# The n8n workflow spawns the Claude CLI on the Mac Mini, authenticated
# via the user's Claude.ai subscription token in macOS Keychain
# ("Claude Code-credentials"). No env var needed at the dashboard layer.

# --- n8n integration ---
# Tunnel URL where the main n8n workflow listens
N8N_WEBHOOK_URL=https://n8n.your-tunnel.example.com/webhook/respond-ticket
# n8n Mac Mini reads this to call back to /api/webhook/n8n-callback
DASHBOARD_CALLBACK_URL=https://your-vercel-deploy.vercel.app/api/webhook/n8n-callback
